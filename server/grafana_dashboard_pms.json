          },
          "query": "import \"strings\"\r\n\r\nfrom(bucket: \"server-bapuk\")\r\n  |> range(start: -5m)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"pms_data\")\r\n  |> last()\r\n  // JURUS SAKTI: Geser waktu 7 jam ke depan (WIB)\r\n  |> timeShift(duration: 7h) \r\n  |> map(fn: (r) => ({\r\n      _value: strings.substring(v: string(v: r._time), start: 11, end: 19),\r\n      _field: \"jam_wib\"\r\n    }))",
          "refId": "A"
        }
      ],
      "title": "Jam",
      "transformations": [
