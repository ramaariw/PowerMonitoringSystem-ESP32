    {
        "id": "b34c645dce87d61f",
        "type": "ui_template",
        "z": "d199be2a42f13f6b",
        "group": "4fd7ea995d1d7535",
        "name": "",
        "order": 8,
        "width": 0,
        "height": 0,
        "format": "<style>\n  .modern-card {\n      background: #1e1e1e;\n      padding: 15px;\n      border-radius: 10px;\n      box-shadow: 0 0 20px rgba(0,0,0,0.3);\n      color: #fff;\n      font-family: \"Segoe UI\", sans-serif;\n      margin-bottom: 15px;\n  }\n\n  .modern-title {\n      font-size: 18px;\n      font-weight: 600;\n      margin-bottom: 10px;\n      color: #4da6ff;\n  }\n\n  .modern-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n      font-size: 16px;\n  }\n\n  .item-label {\n      opacity: 0.7;\n  }\n\n  .item-value {\n      font-size: 20px;\n      font-weight: bold;\n      text-align: right;\n  }\n\n  .battery-bar {\n      width: 100%;\n      height: 12px;\n      background: #333;\n      border-radius: 10px;\n      overflow: hidden;\n      margin-top: 5px;\n  }\n\n  .battery-fill {\n      height: 100%;\n      width: 0%;\n      transition: width 0.5s ease, background 0.5s ease;\n  }\n</style>\n\n<script>\n(function(scope) {\n    scope.$watch('msg', function(msg) {\n        if (!msg || !msg.payload) return;\n\n        let val = msg.payload.persenBatt;\n        let bar = document.getElementById(\"batteryFill\");\n\n        if (!bar) return;\n\n        // Width 0–100%\n        bar.style.width = val + \"%\";\n\n        // Warna berdasarkan level baterai\n        if (val < 20) {\n            bar.style.background = \"#ff3b30\";   // merah\n        } else if (val < 50) {\n            bar.style.background = \"#ffcc00\";   // kuning\n        } else {\n            bar.style.background = \"#4cff4c\";   // hijau\n        }\n    });\n})(scope);\n</script>\n\n<div class=\"modern-card\">\n    <div class=\"modern-title\">Power Monitoring</div>\n\n    <div class=\"modern-grid\">\n        <div class=\"item-label\">Voltage AC</div>\n        <div class=\"item-value\">{{msg.payload.voltageAC}} V</div>\n\n        <div class=\"item-label\">Current AC</div>\n        <div class=\"item-value\">{{msg.payload.currentAC}} A</div>\n\n        <div class=\"item-label\">Power AC</div>\n        <div class=\"item-value\">{{msg.payload.powerAC}} W</div>\n\n        <div class=\"item-label\">Energy</div>\n        <div class=\"item-value\">{{msg.payload.energyAC}} Wh</div>\n\n        <div class=\"item-label\">Voltage DC</div>\n        <div class=\"item-value\">{{msg.payload.voltageDC}} V</div>\n\n        <div class=\"item-label\">Battery</div>\n        <div class=\"item-value\">{{msg.payload.persenBatt}}%</div>\n    </div>\n\n    <div class=\"battery-bar\">\n        <div id=\"batteryFill\" class=\"battery-fill\"></div>\n    </div>\n</div>\n\n<audio id=\"lowBatterySound\" src=\"/sounds/Rusdi4K.mp3\"></audio>\n\n<script>\n(function(scope) {\n    scope.$watch('msg', function(msg) {\n        if (!msg || !msg.payload) return;\n\n        let vdc = msg.payload.voltageDC;\n\n        // Play custom sound if VDC <= 11\n        if (vdc <= 11) {\n            let audio = document.getElementById(\"lowBatterySound\");\n            if (audio) {\n                audio.volume = 1.0;  // Volume 1 = maksimal\n                audio.play();\n            }\n        }\n    });\n})(scope);\n</script>\n\n",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
